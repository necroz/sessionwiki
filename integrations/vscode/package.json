{
  "name": "sessionwiki",
  "displayName": "sessionwiki",
  "description": "Browse and sync your sessionwiki knowledge base from VS Code",
  "version": "0.1.0",
  "publisher": "necroz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/nicobailey/sessionwiki"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "workspaceContains:wiki/index.md"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sessionwiki.openSite",
        "title": "Open sessionwiki",
        "category": "sessionwiki"
      },
      {
        "command": "sessionwiki.sync",
        "title": "Sync Sessions",
        "category": "sessionwiki"
      },
      {
        "command": "sessionwiki.build",
        "title": "Build Site",
        "category": "sessionwiki"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sessionwiki",
          "title": "sessionwiki",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "sessionwiki": [
        {
          "id": "sessionwikiPages",
          "name": "Wiki Pages"
        }
      ]
    },
    "configuration": {
      "title": "sessionwiki",
      "properties": {
        "sessionwiki.serverPort": {
          "type": "number",
          "default": 8765,
          "description": "Port for the sessionwiki local server"
        },
        "sessionwiki.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to the Python interpreter"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0",
    "eslint": "^8.50.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  }
}
